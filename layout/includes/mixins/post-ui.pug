mixin postUI(posts)
  each article , index in posts
    .recent-post-item(class=index === 0 ? 'toybox-featured' : 'toybox-cartridge-card' data-toybox-slot=index data-toybox-number=index + 1 data-toybox-tone=['coral', 'aqua', 'yellow', 'green', 'aqua'][index % 5] role='listitem')
      -
        let link = article.link || article.path
        let title = article.title || _p('no_title')
        const position = theme.cover.position
        let leftOrRight = position === 'both'
          ? index%2 == 0 ? 'left' : 'right'
          : position === 'left' ? 'left' : 'right'
        let post_cover = toybox_cover(article)
        let no_cover = article.cover === false || !theme.cover.index_enable ? 'no-cover' : ''
        let coverSource = article.toybox_cover_source || (post_cover ? 'explicit' : 'none')
        let primaryCategory = article.categories && article.categories.data.length > 0 ? article.categories.data[0].name : ''
        let primaryTag = article.tags && article.tags.data.length > 0 ? article.tags.data[0].name : ''
        // The home stage shows five cartridges at desktop widths: load those
        // covers with the HTML (the first one is the LCP image) and leave the
        // rest to the browser's native lazy loading.
        let eagerCover = is_home() && index < 5
      -
      if post_cover && theme.cover.index_enable
        .post_cover(class=leftOrRight)
          a(href=url_for(link) title=title tabindex='-1' aria-hidden='true')
            if article.cover_type === 'img'
              img.post-bg(src=url_for(post_cover) width='480' height='480' onerror=`this.onerror=null;this.src='${url_for(theme.error_img.post_page)}'` alt='' data-toybox-cover-source=coverSource loading=eagerCover ? 'eager' : 'lazy' fetchpriority=eagerCover && index === 0 ? 'high' : false decoding=eagerCover && index === 0 ? false : 'async')
            else
              div.post-bg.pixel-cover-fallback(style=`background: ${post_cover}` data-cover-title=title data-cover-category=primaryCategory data-cover-tag=primaryTag data-toybox-cover-source=coverSource aria-hidden="true")
            if is_home()
              span.toybox-card-foil(aria-hidden='true')
      .recent-post-info(class=no_cover)
        a.article-title(href=url_for(link) title=title)= title
        .article-meta-wrap
          if (is_home() && (article.top || article.sticky > 0))
            span.article-meta
              i.fas.fa-thumbtack.sticky
              span.sticky= _p('sticky')
              span.article-meta-separator |
          if (theme.post_meta.page.date_type)
            span.post-meta-date
              if (theme.post_meta.page.date_type === 'both')
                i.far.fa-calendar-alt
                span.article-meta-label(data-toybox-i18n='post.created')=toybox_text('post.created')
                time.post-meta-date-created(datetime=date_xml(article.date) title=toybox_text('post.created') + ' ' + full_date(article.date))=date(article.date, config.date_format)
                span.article-meta-separator |
                i.fas.fa-history
                span.article-meta-label(data-toybox-i18n='post.updated')=toybox_text('post.updated')
                time.post-meta-date-updated(datetime=date_xml(article.updated) title=toybox_text('post.updated') + ' ' + full_date(article.updated))=date(article.updated, config.date_format)
              else
                - let data_type_updated = theme.post_meta.page.date_type === 'updated'
                - let date_type = data_type_updated ? 'updated' : 'date'
                - let date_icon = data_type_updated ? 'fas fa-history' :'far fa-calendar-alt'
                - let date_title = data_type_updated ? toybox_text('post.updated') : toybox_text('post.created')
                - let date_i18n = data_type_updated ? 'post.updated' : 'post.created'
                i(class=date_icon)
                span.article-meta-label(data-toybox-i18n=date_i18n)=date_title
                time(datetime=date_xml(article[date_type]) title=date_title + ' ' + full_date(article[date_type]))=date(article[date_type], config.date_format)
          if (theme.post_meta.page.categories && article.categories.data.length > 0)
            span.article-meta
              span.article-meta-separator |
              i.fas.fa-inbox
              each item, index in article.categories.data
                a(href=url_for(item.path)).article-meta__categories #[=item.name]
                if (index < article.categories.data.length - 1)
                  i.fas.fa-angle-right.article-meta-link
          if (theme.post_meta.page.tags && article.tags.data.length > 0)
            span.article-meta.tags
              span.article-meta-separator |
              i.fas.fa-tag
              each item, index in article.tags.data
                a(href=url_for(item.path)).article-meta__tags #[=item.name]
                if (index < article.tags.data.length - 1)
                  span.article-meta-link #[='•']
        //- Article introduction: 1 = description, 2 = description or excerpt, 3 = excerpt, false = none.
        - const excerptMethod = theme.index_post_content.method
        if excerptMethod !== false
          -
            let excerpt = article.description
            if (excerptMethod !== 1 && !(excerptMethod === 2 && excerpt)) {
              const text = strip_html(article.content)
              let end = theme.index_post_content.length
              // strip_html keeps entities: finish one the cut lands in instead of splitting it.
              const cut = /&[#a-z0-9]*$/i.exec(text.substring(0, end))
              const entity = cut && /^&[#a-z0-9]+;/i.exec(text.substring(cut.index))
              if (entity) end = cut.index + entity[0].length
              excerpt = text.length > end ? text.substring(0, end) + ' ...' : text
            }
          .content!= excerpt
        if is_home()
          a.toybox-open-button(href=url_for(link) aria-label=title)
            span.toybox-open-key(aria-hidden='true') A
            span.toybox-open-label(data-toybox-i18n='home.read') 阅读文章
            i.fas.fa-arrow-right(aria-hidden='true')
          a.toybox-card-arrow(href=url_for(link) aria-label=title)
            i.fas.fa-arrow-right(aria-hidden='true')
      if is_home()
        span.toybox-card-glare(aria-hidden='true')
        span.toybox-selection-frame(aria-hidden='true')
