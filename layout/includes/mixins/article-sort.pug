//- One chronological ledger row per post: a single title link, no nested links.
mixin ledgerRow(article, options)
  -
    var title = article.title || _p('no_title')
    var coversEnabled = !theme.cover || theme.cover.archives_enable !== false
    var cover = coversEnabled && article.cover !== false && article.cover_type === 'img' ? toybox_cover(article) : ''
    var categories = !article.categories ? [] : Array.isArray(article.categories) ? article.categories : article.categories.data || []
    var primary = categories[0]
    var excerpt = ''
    if (options.excerpt) {
      excerpt = article.description || strip_html(article.content || '')
      if (excerpt.length > 160) excerpt = excerpt.substring(0, 160) + '…'
    }
  li.toybox-ledger-row(class=cover ? '' : 'is-coverless')
    span.toybox-ledger-thumb(aria-hidden='true')
      if cover
        img(src=url_for(cover) alt='' width='72' height='72' loading='lazy' decoding='async' onerror=`this.onerror=null;this.src='${url_for(theme.error_img.post_page)}'`)
      else
        i.far.fa-file-alt
    .toybox-ledger-body
      a.toybox-ledger-title(href=url_for(article.path))= title
      .toybox-ledger-meta
        time(datetime=date_xml(article.date))= date(article.date, config.date_format)
        if primary
          span.toybox-ledger-category= primary.name
      if excerpt
        p.toybox-ledger-excerpt= excerpt
    i.fas.fa-chevron-right.toybox-ledger-arrow(aria-hidden='true')

mixin articleSort(posts, options)
  -
    options = options || {}
    var rows = Array.isArray(posts) ? posts : posts.toArray()
    var groups = []
    rows.forEach(function (article) {
      var year = options.groupByYear ? date(article.date, 'YYYY') : ''
      var last = groups[groups.length - 1]
      if (!last || last.year !== year) groups.push(last = { year: year, posts: [] })
      last.posts.push(article)
    })
  each group in groups
    if group.year
      h2.toybox-ledger-year= group.year
    ol.toybox-ledger-list
      each article in group.posts
        +ledgerRow(article, options)
