- var top_img_404 = theme.error_404.background || theme.error_img.post_page || theme.default_top_img

#error-wrap
  .error-content
    .error-img
      img(src=url_for(top_img_404) alt='Page not found')
    .error-info
      h1.error_title= '404'
      .error_subtitle= theme.error_404.subtitle || _p('error404')
      .pixel-error-actions
        a.pixel-error-action.is-home(href=url_for('/') data-toybox-i18n='notFound.home')= toybox_text('notFound.home')
        a.pixel-error-action(href=url_for('/archives/') data-toybox-i18n='notFound.archives')= toybox_text('notFound.archives')
