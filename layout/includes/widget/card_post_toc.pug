- let tocNumber = page.toc_number !== undefined ? page.toc_number : theme.toc.number
- let tocExpand = page.toc_expand !== undefined ? page.toc_expand : theme.toc.expand
- let tocExpandClass = tocExpand ? 'is-expand' : ''

#card-toc.card-widget(class=is_post() ? 'pixel-manual-index' : '' aria-label='文章目录' data-toybox-i18n-aria='post.toc')
  .item-headline
    i.fas.fa-stream(aria-hidden='true')
    span(data-toybox-i18n='post.toc')= _p('aside.card_toc')
    span.toc-percentage
    if is_post()
      button.toybox-toc-close(type='button' data-reader-action='close-toc' aria-label='关闭目录' title='关闭目录' data-toybox-i18n-aria='post.closeToc' data-toybox-i18n-title='post.closeToc')
        i.fas.fa-times(aria-hidden='true')

  if (page.encrypt == true)
    .toc-content.toc-div-class(class=tocExpandClass style="display:none")!=toc(page.origin, {list_number: tocNumber})
  else
    .toc-content(class=tocExpandClass)!=toc(page.content, {list_number: tocNumber})
