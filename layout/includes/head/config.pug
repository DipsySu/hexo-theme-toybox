-
  // Serialise for an inline <script>: JSON keeps quotes and backslashes valid JS,
  // and escaping '<' stops a value from closing the tag (</script>).
  const toJs = value => value === undefined ? 'undefined' : JSON.stringify(value).replace(/</g, '\\u003c')

  let localSearch
  if (theme.local_search.enable) {
    localSearch = {
      path: theme.local_search.CDN || config.root + config.search.path,
      preload: theme.local_search.preload,
      top_n_per_article: theme.local_search.top_n_per_article,
      unescape: theme.local_search.unescape,
      languages: {
        hits_empty: _p('search.local_search.hits_empty'),
        hits_stats: _p('search.local_search.hits_stats')
      }
    }
  }

  // Not named toyboxSettings: rightside.pug declares that const in the same compiled scope.
  const runtimeSettings = (theme.toybox || {}).settings || {}
  const toybox = {
    colorMode: (runtimeSettings.color_mode || {}).default || 'auto',
    locale: (runtimeSettings.locale || {}).default || 'zh-CN'
  }

  let highlight
  if ((config.highlight && config.highlight.enable) || (config.prismjs && config.prismjs.enable)) {
    highlight = {
      plugin: config.highlight && config.highlight.enable ? 'highlightjs' : 'prismjs',
      highlightCopy: theme.highlight_copy,
      highlightLang: theme.highlight_lang,
      highlightHeightLimit: theme.highlight_height_limit
    }
  }

  // Fancybox is loaded on demand by btf.loadLightbox, only on pages with article images.
  const lightbox = theme.fancybox ? { css: toybox_asset(theme.asset.fancybox_css), js: toybox_asset(theme.asset.fancybox) } : null

  let isHighlightShrink
  if (theme.highlight_shrink == 'none') isHighlightShrink = 'undefined'
  else if (page.highlight_shrink === true || page.highlight_shrink === false) isHighlightShrink = page.highlight_shrink
  else isHighlightShrink = theme.highlight_shrink

script.
  window.GLOBAL_CONFIG = {
    root: !{toJs(config.root)},
    localSearch: !{toJs(localSearch)},
    toybox: !{toJs(toybox)},
    highlight: !{toJs(highlight)},
    copy: {
      success: !{toJs(_p('copy.success'))},
      noSupport: !{toJs(_p('copy.noSupport'))}
    },
    relativeDate: {
      homepage: !{toJs(theme.post_meta.page.date_format === 'relative')},
      post: !{toJs(theme.post_meta.post.date_format === 'relative')}
    },
    dateSuffix: {
      just: !{toJs(_p('date_suffix.just'))},
      min: !{toJs(_p('date_suffix.min'))},
      hour: !{toJs(_p('date_suffix.hour'))},
      day: !{toJs(_p('date_suffix.day'))},
      month: !{toJs(_p('date_suffix.month'))}
    },
    lightbox: !{toJs(lightbox)},
    islazyload: !{toJs(theme.lazyload.enable)},
    isAnchor: !{toJs(theme.anchor.auto_update)},
    isPhotoFigcaption: !{toJs(theme.photofigcaption)},
    percent: {
      toc: !{toJs(theme.toc.scroll_percent)},
      rightside: !{toJs(theme.rightside_scroll_percent)}
    }
  }
  var GLOBAL_CONFIG_SITE = {
    title: !{toJs(String(pageTitle || ''))},
    isPost: !{is_post()},
    isHighlightShrink: !{isHighlightShrink},
    isToc: !{showToc}
  }
