include ../mixins/post-meta.pug

#post-info
  a.toybox-post-back(href=url_for('/'))
    i.fas.fa-arrow-left(aria-hidden='true')
    span(data-toybox-i18n='home.library') 文章库
  if page.cover && page.cover_type === 'img'
    img.pixel-article-sleeve-art(src=url_for(toybox_cover(page)) width='168' height='176' alt='')
  h1.post-title= page.title || _p('no_title')
    if theme.post_edit.enable
      a.post-edit-link(href=theme.post_edit.url + page.source title=_p('post.edit') target="_blank")
        i.fas.fa-pencil-alt
        
  #post-meta
    .meta-firstline
      if (theme.post_meta.post.date_type)
        span.post-meta-date
          +metaDates(page, theme.post_meta.post.date_type, 'post-meta', ' fa-fw post-meta-icon')
      if (theme.post_meta.post.categories && page.categories.data.length > 0)
        span.post-meta-categories
          if (theme.post_meta.post.date_type)
            span.post-meta-separator |

          each item, index in page.categories.data
            i.fas.fa-inbox.fa-fw.post-meta-icon
            a(href=url_for(item.path)).post-meta-categories #[=item.name]
            if (index < page.categories.data.length - 1)
              i.fas.fa-angle-right.post-meta-separator

    .meta-secondline
      - let postWordcount = theme.wordcount.enable && (theme.wordcount.post_wordcount || theme.wordcount.min2read)
      if (postWordcount)
        span.post-meta-separator |
        span.post-meta-wordcount
          if theme.wordcount.post_wordcount
            i.far.fa-file-word.fa-fw.post-meta-icon
            span.post-meta-label(data-toybox-i18n="post.wordcount")= toybox_text('post.wordcount')
            span=':'
            span.word-count= wordcount(page.content)
            if theme.wordcount.min2read
              span.post-meta-separator |
          if theme.wordcount.min2read
            i.far.fa-clock.fa-fw.post-meta-icon
            span.post-meta-label(data-toybox-i18n="post.readingTime")= _p('post.min2read')
            span=':'
            span= min2read(page.content, {cn: 350, en: 160})
            span(data-toybox-i18n="post.minute")= _p('post.min2read_unit')
    
      //- Page views
      if theme.busuanzi.page_pv
        span.post-meta-separator |
        span.post-meta-pv-cv(id='' data-flag-title=page.title)
          i.far.fa-eye.fa-fw.post-meta-icon
          span.post-meta-label(data-toybox-i18n="post.pageViews")=_p('post.page_pv')
          span=':'
          span#busuanzi_value_page_pv
            i.fa-solid.fa-spinner.fa-spin
