//- Included by post.pug (previous/next article) and index.pug (library console).
include ./mixins/page-step.pug

mixin postStep(post, dir, pull)
  - var isPrev = dir === 'prev'
  div(class=dir + '-post ' + pull)
    a(href=url_for(post.path) title=post.title)
      if post.cover_type === 'img'
        img.cover(src=url_for(toybox_cover(post)) onerror=`onerror=null;src='${url_for(theme.error_img.post_page)}'` alt=isPrev ? 'cover of previous post' : 'cover of next post')
      else
        .cover(style=`background: ${post.cover || 'var(--default-bg-color)'}`)
      .pagination-info
        .label
          if isPrev
            i.fas.fa-arrow-left(aria-hidden='true')
          span(data-toybox-i18n=isPrev ? 'post.previous' : 'post.next')= isPrev ? '上一篇' : '下一篇'
          if !isPrev
            i.fas.fa-arrow-right(aria-hidden='true')
        div(class=dir + '_info')= post.title

if is_post()
  - let prev = theme.post_pagination === 1 ? page.prev : page.next
  - let next = theme.post_pagination === 1 ? page.next : page.prev
  nav#pagination.pagination-post
    if prev
      +postStep(prev, 'prev', next ? 'pull-left' : 'pull-full')
    if next
      +postStep(next, 'next', prev ? 'pull-right' : 'pull-full')
else if is_home()
  - const currentPage = page.current || 1
  - const totalPages = Math.max(1, page.total || 1)
  - const pageSize = config.index_generator.per_page || site.posts.length
  - const firstPost = page.posts.length ? (currentPage - 1) * pageSize + 1 : 0
  - const lastPost = page.posts.length ? firstPost + page.posts.length - 1 : 0
  nav#pagination.toybox-library-pagination(data-current-page=currentPage data-total-pages=totalPages)
    .toybox-library-summary
      span.toybox-library-label(data-toybox-i18n='home.library') 文章库
      span.toybox-library-range(data-toybox-i18n='home.visibleRange' data-toybox-i18n-params=JSON.stringify({start:firstPost,end:lastPost,total:site.posts.length}))= `${firstPost}-${lastPost} / ${site.posts.length} 篇文章`
    .toybox-page-controls
      +pageStep('prev', page.prev && url_for(page.prev_link), '上一页', 'common.previousPage', false, page.prev)
      .toybox-page-picker
        .toybox-page-display(aria-hidden='true')
          span.toybox-page-display-label(data-toybox-i18n='home.pageNumber') 页码
          strong.toybox-page-digits
            span.toybox-page-current= String(currentPage).padStart(2, '0')
            span.toybox-page-divider /
            span.toybox-page-total= String(totalPages).padStart(2, '0')
        select#toybox-page-select(aria-label='跳转到指定页' data-toybox-i18n-aria='home.jumpPage')
          - let pageNumber = 1
          while pageNumber <= totalPages
            - const destination = pageNumber === 1 ? page.base : page.base + (config.pagination_dir || 'page') + '/' + pageNumber + '/'
            option(value=url_for(destination) data-page=pageNumber selected=pageNumber === currentPage data-toybox-i18n='home.pageOption' data-toybox-i18n-params=JSON.stringify({current:pageNumber,total:totalPages}))= `第 ${pageNumber} 页 / 共 ${totalPages} 页`
            - pageNumber++
        i.fas.fa-chevron-down(aria-hidden='true')
      +pageStep('next', page.next && url_for(page.next_link), '下一页', 'common.nextPage', false, page.next)
