include ../mixins/page-step.pug
- var pager = toyboxCollection.pager
if pager.totalPages > 1
  - var rangeParams = { start: pager.start, end: pager.end, total: pager.total }
  nav.toybox-collection-pager(aria-label=toybox_text('collection.pagination') data-toybox-i18n-aria='collection.pagination')
    p.toybox-pager-range(data-toybox-i18n='collection.range' data-toybox-i18n-params=JSON.stringify(rangeParams))= toybox_text('collection.range', rangeParams)
    .toybox-page-controls
      +pageStep('prev', pager.prev, toybox_text('collection.previousPage'), 'collection.previousPage', 'prev')
      .toybox-page-picker
        select#toybox-collection-page(aria-label=toybox_text('collection.jumpPage') data-toybox-i18n-aria='collection.jumpPage' data-toybox-destination disabled)
          each item in pager.pages
            - var optionParams = { current: item.number, total: pager.totalPages }
            option(value=item.url selected=item.current data-toybox-i18n='collection.pageOption' data-toybox-i18n-params=JSON.stringify(optionParams))= toybox_text('collection.pageOption', optionParams)
        i.fas.fa-chevron-down(aria-hidden='true')
      +pageStep('next', pager.next, toybox_text('collection.nextPage'), 'collection.nextPage', 'next')
