#local-search
  .search-dialog
    .local-search-box
      margin: 0 auto
      max-width: 100%
      width: 100%

      input
        width: 100%
        -webkit-appearance: none

    .local-search-hit-item
      position: relative
      line-height: 1.7

      a
        display: block

        &:hover
          color: $search-color

      .search-result-title
        font-weight: 600

      .search-result
        margin: 0 0 8px
        word-break: break-word

    .no-result
      & + #local-search-stats-wrap
        display: none

.search-keyword
  font-weight: bold
