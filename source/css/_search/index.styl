.search-dialog
  position: fixed
  z-index: 1001
  display: none

  .search-nav
    line-height: 1

    .search-dialog-title
      margin-right: 10px

    .search-close-button
      float: right
      transition: color .2s ease-in-out

#search-mask
  position: fixed
  top: 0
  right: 0
  bottom: 0
  left: 0
  z-index: 1000
  display: none
