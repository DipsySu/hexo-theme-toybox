#body-wrap
  display: flex
  flex-direction: column
  min-height: 100vh

.layout
  flex: 1 auto

  +maxWidth900()
    flex-direction: column

  & > div:first-child:not(.recent-posts)
    @extend .cardHover
    align-self: flex-start

  & > div:first-child
    transition: all .3s

    if hexo-config('aside.position') == 'left'
      +minWidth900()
        order: 2
