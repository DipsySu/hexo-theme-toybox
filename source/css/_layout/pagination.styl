#pagination
  .prev_info,
  .next_info
    @extend .limit-one-line
    font-weight: 500

  .prev-post .label,
  .next-post .label
    text-transform: uppercase

  .prev-post,
  .next-post
    @extend .postImgHover

    a
      position: relative
      overflow: hidden

  &.pagination-post
    overflow: hidden
