#rightside
  position: fixed
  bottom: $rightside-bottom
  z-index: 100
  opacity: 0
  transition: all .5s

  & > div
    & > button
      font-size: 16px
      line-height: 35px

  if hexo-config('rightside_scroll_percent')
    #go-up
      .scroll-percent
        display: none

      &.show-percent
        .scroll-percent
          display: block

          & + i
            display: none

      &:hover
        .scroll-percent
          display: none

          & + i
            display: block
