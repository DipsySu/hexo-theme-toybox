if hexo-config('readmode')
  .read-mode
    --font-color: #4c4948
    --white: #4c4948
    --light-grey: #4c4948
    --gray: #d6dbdf
    --hr-border: #d6dbdf
    --highlight-bg: #f7f7f7
    --exit-btn-hover: darken(#C0C0C0, 20)
    --pseudo-hover: none

  [data-theme='dark']
    .read-mode
      --font-color: rgba(255, 255, 255, .7)
      --white: rgba(255, 255, 255, .9)
      --light-grey: rgba(255, 255, 255, .7)
      --gray: rgba(255, 255, 255, .7)
      --hr-border: rgba(255, 255, 255, .5)
      --highlight-bg: #171717
      --exit-btn-hover: lighten(#1f1f1f, 20)

  .read-mode
    .exit-readmode
      border-radius: 8px
      font-size: 16px
      transition: background .3s

      &:hover
        background: var(--exit-btn-hover)

    & > canvas
      display: none !important

    .highlight-tools,
    #footer,
    #post > *:not(#post-info):not(.post-content):not(.pixel-manual-body),
    #rightside
      display: none !important

    #article-container
      pre,
      .highlight:not(.js-file-line-container)
        background: var(--highlight-bg) !important

        *
          color: var(--font-color) !important

      figure.highlight
        border-radius: 0 !important
        box-shadow: none !important

        & > :not(.highlight-tools)
          display: block !important

        .line:before
          color: var(--font-color) !important

        .hljs
          background: var(--highlight-bg) !important

      h1,
      h2,
      h3,
      h4,
      h5,
      h6
        padding: 0

        &:before
          content: ''

        &:hover
          padding: 0

      ul,
      li,
      ol
        &:hover:before
          transform: none !important

      ol,
      li
        &:before
          background: transparent !important
          color: var(--font-color) !important

      ul
        >li
          &:before
            border-color: var(--gray) !important

      code
        color: var(--font-color)

      blockquote
        border-color: var(--gray)

      kbd
        border: 1px solid var(--gray)
        background-color: transparent
        box-shadow: none
        color: var(--font-color)
